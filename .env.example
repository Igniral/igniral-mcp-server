# Igniral MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# Agent API Credentials
# Generate these from your Igniral Dashboard (Settings > Agent API Keys)
IGNIRAL_CLIENT_ID=your-client-id-here
IGNIRAL_CLIENT_SECRET=your-client-secret-here

# Base URL for the Igniral Auth Server
IGNIRAL_AUTH_URL=https://auth.igniral.com

# Base URL for the json-elements microservice
IGNIRAL_API_URL=https://api.igniral.io

# Base URL for the ai-schema-builder microservice
IGNIRAL_AI_API_URL=https://igniral-microservice-ai-schema-builder-937294487413.us-central1.run.app
