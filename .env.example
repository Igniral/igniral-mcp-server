# Igniral MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# Agent API Credentials (required)
# Generate these from your Igniral Dashboard (Settings > Agent API Keys)
IGNIRAL_CLIENT_ID=your-client-id-here
IGNIRAL_CLIENT_SECRET=your-client-secret-here

# URLs (optional — defaults shown below)
# IGNIRAL_AUTH_URL=https://auth.igniral.com
# IGNIRAL_API_URL=https://api.igniral.io
# IGNIRAL_AI_API_URL=https://ai.igniral.com